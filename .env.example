# Copy this file to .env  (cp .env.example .env)
# .env is git-ignored — never commit your token.

# Your BGG application token (https://boardgamegeek.com/applications).
# Leave blank until approved: the API runs in MOCK mode with sample games.
BGG_TOKEN=

# Force mock mode even when a token is set (handy for offline UI work).
USE_MOCK=false

# --- Database sync ---
# A collection older than this (minutes) is refreshed in the background when the page asks for it.
REFRESH_MINUTES=60
# Re-fetch a game's weight + player-count poll after this many days.
DETAILS_MAX_AGE_DAYS=30
# Hour of the day (0-23) to refresh every saved collection. -1 turns it off.
NIGHTLY_SYNC_HOUR=4
# Time zone for the nightly sync hour.
TZ=America/New_York

# --- Sign-in ---
# true = the login cookie is only sent over HTTPS. Keep false for local
# development (http://localhost). In production (docker-compose.prod.yml) it
# defaults to true; set it to false there only if you sign in over plain
# http://<server-ip>:8080.
SECURE_COOKIES=false

# --- Production only (docker-compose.prod.yml) ---
# Where the database is kept on the server, and the port the app is served on.
# DATA_DIR=/DATA/AppData/bgg-game-night/data
# WEB_PORT=8080
# How often Watchtower checks ghcr.io for new images (seconds).
# UPDATE_CHECK_SECONDS=300
# Folder holding the ghcr.io login, if the images are private (see README).
# REGISTRY_LOGIN_DIR=/DATA/AppData/bgg-game-night/registry-login
